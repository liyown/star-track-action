{
  "name": "star-track-action",
  "description": "A self-contained, beautifully typeset GitHub open-source profile.",
  "version": "2.0.0",
  "author": "Liuyaowen",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/liyown/star-track-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyown/star-track-action.git"
  },
  "bugs": {
    "url": "https://github.com/liyown/star-track-action/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src test script/*.ts",
    "test": "tsx --test test/*.test.ts",
    "ci-test": "npm test",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "bundle": "npm run package",
    "preview": "tsx script/preview.ts",
    "collect": "tsx script/collect.ts",
    "all": "npm run typecheck && npm run lint && npm test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@octokit/rest": "^21.1.1",
    "fontkit": "^2.0.4",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^20.17.30",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "rollup": "^4.40.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  }
}
